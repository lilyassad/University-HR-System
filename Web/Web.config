<?xml version="1.0"?>
<configuration>
  <connectionStrings>
    <!-- One connection string for the whole site. Change Data Source to your SQL Server instance. -->
    <add name="HRConnection"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=University_HR_ManagementSystem_Team_20;Integrated Security=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <!-- The brief says admin credentials are hard coded (no admin table). Change these. -->
    <add key="AdminID" value="admin" />
    <add key="AdminPassword" value="admin123" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" maxRequestLength="10240" />
    <sessionState timeout="30" />
  </system.web>
</configuration>
